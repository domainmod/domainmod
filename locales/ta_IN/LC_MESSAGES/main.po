#: admin/domain-fields/add.php:137 admin/hosting-fields/add.php:146 admin/ssl-fields/add.php:137
msgid "The Database Field Name can contain only letters and underscores (i.e. sample_field or SampleField)."
msgstr "தரவுத்தள புலத்தின் பெயரில் எழுத்துக்கள் மற்றும் அடிக்கீற்றுகள் மட்டுமே இருக்கலாம் (எ.கா. sample_field அல்லது SampleField)."

#: admin/domain-fields/edit.php:95 admin/domain-fields/edit.php:173 admin/domain-fields/edit.php:211 admin/hosting-fields/edit.php:104 admin/hosting-fields/edit.php:182 admin/hosting-fields/edit.php:220 admin/ssl-fields/edit.php:95 admin/ssl-fields/edit.php:173 admin/ssl-fields/edit.php:211 bulk/cf/step-two/index.php:195
