msgid "Failed items put back in the queue"
msgstr "ناکام اشیاء کو دوبارہ قطار میں رکھ دیا گیا۔"

#: queue/ssl/index.php:93
msgid "%s row wasn't retried, since the same hostname is already in the queue."
msgid_plural "%s rows weren't retried, since the same hostname is already in the queue."
msgstr[0] "%s اندراج کو دوبارہ نہیں آزمایا گیا کیونکہ وہی ہوسٹ نام پہلے ہی قطار میں موجود ہے۔"
msgstr[1] "%s اندراجات دوبارہ نہیں آزمائے گئے، کیونکہ وہی ہوسٹ نام پہلے ہی قطار میں موجود ہے۔"

