#: admin/settings/index.php:169
msgid "Email Signature"
msgstr "ای میل دستخط"

#: admin/settings/index.php:169
msgid "Every email sent by the system (new account notices, expiration emails, etc.), includes an email signature, which includes a user's full name and email address. Use the below menu to choose the user that you would like to appear in your system's email signature."
msgstr "سسٹم کی طرف سے بھیجی گئی ہر ای میل (نئے اکاؤنٹ نوٹسز، میعاد ختم ہونے والی ای میلز وغیرہ) میں ایک ای میل دستخط شامل ہوتا ہے، جس میں صارف کا پورا نام اور ای میل پتہ شامل ہوتا ہے۔ اس صارف کو منتخب کرنے کے لیے نیچے دیے گئے مینو کا استعمال کریں جسے آپ اپنے سسٹم کے ای میل دستخط میں ظاہر کرنا چاہتے ہیں۔"

#: admin/settings/index.php:181
