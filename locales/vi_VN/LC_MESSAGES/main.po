msgstr "Xem trang %sHàng đợi SSL%s trong Hướng dẫn sử dụng."

#: queue/add/ssl.php:266
msgid "Match each certificate's issuer (recommended)"
msgstr "Phù hợp với đơn vị cấp chứng chỉ tương ứng (được khuyến nghị)"

#: queue/add/ssl.php:272
msgid "Used when each certificate's issuer is matched. A chosen account's own owner is used instead. Same as the Domain uses the owner of each new certificate's domain, or your SSL defaults for one without a domain."
msgstr "Được dùng khi khớp theo đơn vị cấp của từng chứng chỉ. Nếu chọn một tài khoản, chủ sở hữu của chính tài khoản đó sẽ được dùng. “Giống như tên miền” dùng chủ sở hữu của tên miền của mỗi chứng chỉ mới, hoặc các thiết lập mặc định SSL của bạn đối với chứng chỉ không có tên miền."

