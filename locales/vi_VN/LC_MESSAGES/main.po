#: ssl/edit.php:658
msgid "Delete this SSL certificate"
msgstr "Xóa chứng chỉ SSL này"

#: ssl/edit.php:658
msgid "This removes %s and its details from %s. It can't be undone."
msgstr "Thao tác này sẽ xóa %s và các thông tin chi tiết của nó khỏi %s. Thao tác này không thể hoàn tác."

#: ssl/index.php:623
msgid "SSL certificates belong to an SSL provider account, so start by adding the company you buy them from."
msgstr "Chứng chỉ SSL thuộc về tài khoản của nhà cung cấp SSL, vì vậy trước tiên hãy thêm công ty mà bạn mua chứng chỉ từ đó."

#: ssl/index.php:629
msgid "Add an SSL provider account next"
msgstr "Tiếp theo, hãy thêm tài khoản nhà cung cấp SSL"

#: ssl/index.php:629
msgid "Add the account you hold at that SSL provider."
msgstr "Hãy thêm tài khoản mà bạn đang sở hữu tại nhà cung cấp SSL đó."

#: ssl/index.php:636
msgid "Add a domain first"
msgstr "Trước tiên, hãy thêm một tên miền"

#: ssl/index.php:636
msgid "Each SSL certificate belongs to a domain, so add the domain it covers."
msgstr "Mỗi chứng chỉ SSL đều thuộc về một tên miền, vì vậy hãy thêm tên miền mà chứng chỉ đó áp dụng."

#: ssl/index.php:636
msgid "Go to Domains"
msgstr "Truy cập vào phần Tên miền"

#: ssl/index.php:642
msgid "No SSL certificates yet"
msgstr "Chưa có chứng chỉ SSL"

#: ssl/index.php:642
msgid "Add the SSL certificates you want to keep track of."
msgstr "Thêm các chứng chỉ SSL mà bạn muốn theo dõi."

#: ssl/index.php:1668
msgid "No live SSL certificates"
msgstr "Không có chứng chỉ SSL đang dùng"

#: ssl/index.php:1668
msgid "Your SSL certificates are all expired or inactive."
msgstr "Tất cả các chứng chỉ SSL của bạn đều đã hết hạn hoặc không còn hoạt động."

#: ssl/index.php:1668
msgid "Show all SSL certificates"
msgstr "Hiển thị tất cả các chứng chỉ SSL"

#: ssl/index.php:1672 ssl/index.php:1682
msgid "Some SSL certificates are hidden until they have a fee"
msgstr "Một số chứng chỉ SSL sẽ được ẩn đi cho đến khi có khoản phí"

#: ssl/index.php:1672 ssl/index.php:1682
msgid "SSL certificates without a fee can't be costed, so they don't appear in the list yet."
msgstr "Các chứng chỉ SSL chưa có phí không thể được tính chi phí, do đó chúng chưa xuất hiện trong danh sách."

#: ssl/index.php:1686
msgid "No SSL certificates match your filters"
msgstr "Không có chứng chỉ SSL nào phù hợp với các tiêu chí lọc của bạn"

#: ssl/notes.php:86
msgid "Notes you add when editing this SSL certificate show here."
msgstr "Các ghi chú mà bạn thêm vào khi chỉnh sửa chứng chỉ SSL này sẽ hiển thị tại đây."

