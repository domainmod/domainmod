#: settings/profile/index.php:185
msgid "Your profile was updated."
msgstr "तुमचे प्रोफाइल अपडेट केले गेले."

#: settings/toggles/getting-started/index.php:56
msgid "The Getting Started checklist is hidden. You can show it again in %sDisplay Settings%s."
msgstr "'सुरुवात कशी करावी' चेकलिस्ट लपवलेली आहे. तुम्ही ती %sडिस्प्ले सेटिंग्जमध्ये%s पुन्हा दाखवू शकता."

#: settings/toggles/getting-started/index.php:60
msgid "The Getting Started checklist couldn't be hidden. Please try again."
msgstr "'सुरुवात कशी करावी' चेकलिस्ट लपवता आली नाही. कृपया पुन्हा प्रयत्न करा."

#: ssl/edit.php:658
msgid "Delete this SSL certificate"
msgstr "हे SSL प्रमाणपत्र हटवा"

#: ssl/edit.php:658
msgid "This removes %s and its details from %s. It can't be undone."
msgstr "हे %s आणि त्याचे तपशील %s मधून काढून टाकते. हे परत करता येणार नाही."

#: ssl/index.php:623
msgid "SSL certificates belong to an SSL provider account, so start by adding the company you buy them from."
msgstr "SSL प्रमाणपत्रे SSL प्रदात्याच्या खात्याशी संबंधित असतात, त्यामुळे प्रथम तुम्ही ज्या कंपनीकडून ती खरेदी करता ती कंपनी जोडा."

#: ssl/index.php:629
msgid "Add an SSL provider account next"
msgstr "पुढे SSL प्रदात्याचे खाते जोडा"

#: ssl/index.php:629
msgid "Add the account you hold at that SSL provider."
msgstr "त्या SSL प्रदात्याकडे तुमचे खाते जोडा."

#: ssl/index.php:636
msgid "Add a domain first"
msgstr "प्रथम डोमेन जोडा"

#: ssl/index.php:636
msgid "Each SSL certificate belongs to a domain, so add the domain it covers."
msgstr "प्रत्येक SSL प्रमाणपत्र एखाद्या डोमेनशी संबंधित असते, त्यामुळे ते कोणते डोमेन कव्हर करते ते जोडा."

#: ssl/index.php:636
msgid "Go to Domains"
msgstr "डोमेन्सवर जा"

#: ssl/index.php:642
msgid "No SSL certificates yet"
msgstr "अद्याप SSL प्रमाणपत्रे नाहीत"

#: ssl/index.php:642
msgid "Add the SSL certificates you want to keep track of."
msgstr "आपण ट्रॅक ठेवू इच्छित असलेली SSL प्रमाणपत्रे जोडा."

#: ssl/index.php:1668
msgid "No live SSL certificates"
msgstr "कोणतेही लाइव्ह SSL प्रमाणपत्रे नाहीत"

#: ssl/index.php:1668
msgid "Your SSL certificates are all expired or inactive."
msgstr "तुमची सर्व SSL प्रमाणपत्रे कालबाह्य किंवा निष्क्रिय आहेत."

#: ssl/index.php:1668
msgid "Show all SSL certificates"
msgstr "सर्व SSL प्रमाणपत्रे दाखवा"

#: ssl/index.php:1672 ssl/index.php:1682
msgid "Some SSL certificates are hidden until they have a fee"
msgstr "शुल्क जोडले जाईपर्यंत काही SSL प्रमाणपत्रे लपवलेली असतात"

#: ssl/index.php:1672 ssl/index.php:1682
msgid "SSL certificates without a fee can't be costed, so they don't appear in the list yet."
msgstr "शुल्कविना SSL प्रमाणपत्रांना किंमत लावता येत नाही, त्यामुळे ती अद्याप यादीत दिसत नाहीत."

#: ssl/index.php:1686
msgid "No SSL certificates match your filters"
msgstr "तुमच्या फिल्टरशी कोणतेही SSL प्रमाणपत्र जुळत नाहीत"

#: ssl/notes.php:86
msgid "Notes you add when editing this SSL certificate show here."
msgstr "या SSL प्रमाणपत्राचे संपादन करताना तुम्ही जोडलेल्या टिपा येथे दिसतात."

