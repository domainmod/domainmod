msgstr[1] "तुमच्या यादीत %s अवैध होस्टनाम आहेत."

#: queue/add/ssl.php:182
msgid "You can add up to %s hostnames at a time. Please split your list and add it in parts."
msgstr "तुम्ही एकावेळी %s पर्यंत होस्टनाम जोडू शकता. कृपया तुमची यादी विभागून टप्प्याटप्प्याने जोडा."

#: queue/add/ssl.php:220
msgid "Hostnames Added To Queue"
msgstr "होस्टनाम्स रांगेत जोडले गेले"

