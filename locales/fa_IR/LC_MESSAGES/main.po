#: restore.php:50
msgid "Usage: php restore.php <backup file> --temp-dir=<folder>, php restore.php --recover, or php restore.php --forget-staged"
msgstr "نحوه استفاده: php restore.php <فایل پشتیبان> --temp-dir=<پوشه>, php restore.php --recover, یا php restore.php --forget-staged"

#: restore.php:54
msgid "--recover and --forget-staged each run on their own, with no backup file or --temp-dir."
msgstr "--recover و --forget-staged هر یک به تنهایی اجرا می‌شوند، بدون فایل پشتیبان یا --temp-dir."

#: restore.php:83
msgid "Can't read %s. Run this as the web server's user."
msgstr "نمی‌توان %s را خواند. این را با حساب کاربری وب‌سرور اجرا کنید."

