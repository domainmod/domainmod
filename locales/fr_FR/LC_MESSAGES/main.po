#: restore.php:40
msgid "This script can only be run from the command line. To restore from your browser, sign in to %s as an administrator."
msgstr "Ce script ne peut être exécuté qu'à partir de la ligne de commande. Pour effectuer une restauration depuis votre navigateur, connectez-vous à %s en tant qu'administrateur."

#: restore.php:50
msgid "Usage: php restore.php <backup file> --temp-dir=<folder>, php restore.php --recover, or php restore.php --forget-staged"
msgstr "Utilisation : php restore.php <fichier de sauvegarde> --temp-dir=<dossier>, php restore.php --recover ou php restore.php --forget-staged"

#: restore.php:54
msgid "--recover and --forget-staged each run on their own, with no backup file or --temp-dir."
msgstr "Les options --recover et --forget-staged s'exécutent chacune séparément, sans fichier de sauvegarde ni répertoire --temp-dir."

#: restore.php:83
msgid "Can't read %s. Run this as the web server's user."
msgstr "Impossible de lire %s. Exécutez cette commande en tant qu'utilisateur du serveur web."

#: restore.php:85
msgid "Can't write to DomainMOD's temp folder. Make it writable by the web server's user, then try again."
msgstr "Impossible d'écrire dans le dossier temporaire de DomainMOD. Rendez-le accessible en écriture pour l'utilisateur du serveur web, puis réessayez."

#: restore.php:87
msgid "Can't open temp/restore.lock for writing. Run this as the web server's user."
msgstr "Impossible d'ouvrir le fichier « temp/restore.lock » en mode écriture. Exécutez cette commande en tant qu'utilisateur du serveur web."

#: restore.php:100
msgid "There is no staged backup copy to forget."
msgstr "Il n'y a pas de copie de sauvegarde en attente à oublier."

#: restore.php:103
msgid "This forgets the staged backup copy at %s without deleting it. Only do this if the file is already gone. Type yes to go on:"
msgstr "Cette opération ignore la copie de sauvegarde en attente située dans %s sans la supprimer. Ne procédez ainsi que si le fichier a déjà été supprimé. Tapez « yes » pour continuer :"

#: restore.php:145
msgid "The staged backup copy changed while you were answering, so nothing was changed."
msgstr "La copie de sauvegarde en attente a été modifiée pendant que vous répondiez ; par conséquent, rien n'a été modifié."

#: restore.php:149
msgid "The staged backup copy was forgotten."
msgstr "La copie de sauvegarde en attente a été oubliée."

#: restore.php:149
msgid "The staged backup copy's record couldn't be removed."
msgstr "L'enregistrement de la copie de sauvegarde en attente n'a pas pu être supprimé."

#: restore.php:164
msgid "The restore was finished."
msgstr "La restauration est terminée."

#: restore.php:171
msgid "The staged backup copy was removed."
msgstr "La copie de sauvegarde en attente a été supprimée."

#: restore.php:171
msgid "Nothing was left to finish."
msgstr "Il ne restait plus rien à terminer."

#: restore.php:181
msgid "The --temp-dir folder doesn't exist or can't be written to."
msgstr "Le dossier --temp-dir n'existe pas ou n'est pas accessible en écriture."

#: restore.php:187
msgid "The --temp-dir folder can't be inside DomainMOD's folder. Use a private folder outside the web root."
msgstr "Le dossier --temp-dir ne doit pas se trouver dans le dossier DomainMOD. Utilisez un dossier dédié situé en dehors de la racine du site web."

#: restore.php:211
msgid "The restore finished."
msgstr "La restauration est terminée."

