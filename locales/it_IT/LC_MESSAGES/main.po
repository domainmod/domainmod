msgid "Usage: php restore.php <backup file> --temp-dir=<folder>, php restore.php --recover, or php restore.php --forget-staged"
msgstr "Utilizzo: php restore.php <file di backup> --temp-dir=<cartella>, php restore.php --recover oppure php restore.php --forget-staged"

