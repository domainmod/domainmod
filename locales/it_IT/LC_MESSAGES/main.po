#: restore.php:145
msgid "The staged backup copy changed while you were answering, so nothing was changed."
msgstr "La copia di backup provvisoria è stata modificata mentre rispondevi, quindi non è stato modificato nulla."

#: restore.php:149
msgid "The staged backup copy was forgotten."
msgstr "La copia di backup preparata è stata dimenticata."

#: restore.php:149
msgid "The staged backup copy's record couldn't be removed."
msgstr "Non è stato possibile rimuovere il record della copia di backup in fase di elaborazione."

#: restore.php:164
msgid "The restore was finished."
msgstr "Il ripristino è stato completato."

#: restore.php:171
msgid "The staged backup copy was removed."
msgstr "La copia di backup temporanea è stata rimossa."

#: restore.php:171
msgid "Nothing was left to finish."
msgstr "Non c'era più nulla da finire."

#: restore.php:181
msgid "The --temp-dir folder doesn't exist or can't be written to."
msgstr "La cartella --temp-dir non esiste o non è possibile scriverci."

#: restore.php:187
msgid "The --temp-dir folder can't be inside DomainMOD's folder. Use a private folder outside the web root."
msgstr "La cartella --temp-dir non può trovarsi all'interno della cartella di DomainMOD. Utilizza una cartella privata al di fuori della radice del sito web."

#: restore.php:211
msgid "The restore finished."
msgstr "Il ripristino è terminato."

