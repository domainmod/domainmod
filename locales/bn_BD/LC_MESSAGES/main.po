msgid "Debugging Mode"
msgstr "ডিবাগিং মোড"

#: admin/settings/index.php:194
msgid "Unless you're having problems with %s and support has asked you to turn this on, you should leave it turned off."
msgstr "%s এর সাথে আপনার সমস্যা না হলে এবং সমর্থন আপনাকে এটি চালু করতে বলেছে, আপনার এটি বন্ধ রাখা উচিত।"

#: admin/settings/index.php:196
msgid "Local PHP Log"
msgstr "স্থানীয় পিএইচপি লগ"

#: admin/settings/index.php:197
msgid "This allows you to log PHP errors in a local file called domainmod.log, instead of recording them in the main PHP log."
msgstr "এটি আপনাকে পিএইচপি ত্রুটিগুলিকে মূল পিএইচপি লগে রেকর্ড করার পরিবর্তে domainmod.log নামক একটি স্থানীয় ফাইলে লগ করার অনুমতি দেয়।"

#: admin/settings/index.php:198
msgid "Only enable this feature temporarily for troubleshooting, and if you're asked to by %s support."
msgstr "সমস্যা সমাধানের জন্য শুধুমাত্র সাময়িকভাবে এই বৈশিষ্ট্যটি সক্ষম করুন, এবং যদি আপনাকে %s সমর্থন দ্বারা বলা হয়।"

#: admin/settings/index.php:199
msgid "Leaving it enabled all the time will cause logged errors to be visible to everyone who knows the URL to your %s installation, which could allow them to compromise your system."
msgstr "এটিকে সব সময় সক্ষম করে রাখলে আপনার %s ইনস্টলেশনের URL যারা জানে তাদের প্রত্যেকের কাছে লগ করা ত্রুটিগুলি দৃশ্যমান হবে, যা তাদের আপনার সিস্টেমে আপোস করার অনুমতি দিতে পারে।"

