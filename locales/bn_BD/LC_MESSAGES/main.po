msgstr "%2$s-এর মধ্যে %1$s নম্বর প্রচেষ্টা ব্যর্থ হয়েছে।"

#: classes/DomainMOD/SslQueue.php:794 queue/index.php:223 queue/index.php:760
msgid "Imported"
msgstr "আমদানি করা"

#: classes/DomainMOD/SslQueue.php:795
msgid "Not trusted"
msgstr "বিশ্বাসযোগ্য নয়"

#: classes/DomainMOD/SslQueue.php:800
msgid "Already in SSL Queue"
msgstr "ইতিমধ্যেই SSL সারিতে আছে"

#: classes/DomainMOD/SslQueue.php:808
msgid "Failed"
msgstr "ব্যর্থ"

#: classes/DomainMOD/SslRefresh.php:68
msgid "Refresh becomes available after the next database update."
msgstr "পরবর্তী ডাটাবেস আপডেটের পর রিফ্রেশ উপলব্ধ হবে।"

#: classes/DomainMOD/SslRefresh.php:81 classes/DomainMOD/SslRefresh.php:97
msgid "SSL certificate %s couldn't be refreshed."
msgstr "SSL সার্টিফিকেট %s রিফ্রেশ করা যায়নি।"

#: classes/DomainMOD/SslRefresh.php:82
msgid "This SSL certificate is already being refreshed. Please try again in a moment."
msgstr "এই SSL সার্টিফিকেটটি ইতিমধ্যেই রিফ্রেশ হচ্ছে। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন।"

#: classes/DomainMOD/SslRefresh.php:100
msgid "This SSL certificate was changed in another window. Please reload the page and try again."
msgstr "এই SSL সার্টিফিকেটটি অন্য একটি উইন্ডোতে পরিবর্তিত হয়েছে। অনুগ্রহ করে পৃষ্ঠাটি রিলোড করুন এবং আবার চেষ্টা করুন।"

#: classes/DomainMOD/SslRefresh.php:122
msgid "SSL certificate %s refreshed."
msgstr "SSL সার্টিফিকেট %s রিফ্রেশ করা হয়েছে।"

#: classes/DomainMOD/SslRefresh.php:176
msgid "Refresh needs this certificate's Host / Label to be the hostname it's installed on, such as example.com."
msgstr "রিফ্রেশের জন্য এই সার্টিফিকেটের হোস্ট / লেবেলটি সেই হোস্টনাম হতে হবে যেখানে এটি ইনস্টল করা আছে, যেমন example.com।"

#. TRANSLATORS: %1$s is the SSL certificate's Host / Label, and %2$s is the domain it's linked to.
#: classes/DomainMOD/SslRefresh.php:181
msgid "This certificate's Host / Label, %1$s, isn't part of its domain, %2$s. Link the certificate to the right domain, set its Domain to None, or change its Host / Label. Then refresh the certificate."
msgstr "এই সার্টিফিকেটের হোস্ট / লেবেল %1$s এর ডোমেন %2$s-এর অংশ নয়। সার্টিফিকেটটিকে সঠিক ডোমেনের সাথে সংযুক্ত করুন, এর ডোমেন 'কোনও নেই' হিসেবে সেট করুন অথবা এর হোস্ট / লেবেল পরিবর্তন করুন। তারপর সার্টিফিকেটটি রিফ্রেশ করুন।"

#: classes/DomainMOD/SslRefresh.php:217
msgid "Please wait %d second before refreshing this SSL certificate again."
msgid_plural "Please wait %d seconds before refreshing this SSL certificate again."
msgstr[0] "এই SSL সার্টিফিকেটটি আবার রিফ্রেশ করার আগে অনুগ্রহ করে %d সেকেন্ড অপেক্ষা করুন।"
msgstr[1] "অনুগ্রহ করে এই SSL সার্টিফিকেটটি আবার রিফ্রেশ করার আগে %d সেকেন্ড অপেক্ষা করুন।"

#: classes/DomainMOD/SslRefresh.php:225
msgid "Please wait %d second before refreshing another SSL certificate."
msgid_plural "Please wait %d seconds before refreshing another SSL certificate."
msgstr[0] "অনুগ্রহ করে আরেকটি SSL সার্টিফিকেট রিফ্রেশ করার আগে %d সেকেন্ড অপেক্ষা করুন।"
msgstr[1] "অনুগ্রহ করে আরেকটি SSL সার্টিফিকেট রিফ্রেশ করার আগে %d সেকেন্ড অপেক্ষা করুন।"

#: classes/DomainMOD/SslRefresh.php:236
msgid "The lookup had to wait for another connection to the same address. Please try again shortly."
msgstr "লুকআপটিকে একই ঠিকানায় অন্য সংযোগের জন্য অপেক্ষা করতে হয়েছিল। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন।"

#: classes/DomainMOD/SslRefresh.php:285
msgid "The SSL certificate changed while it was being refreshed. Please try again."
msgstr "SSL সার্টিফিকেট রিফ্রেশের সময় পরিবর্তিত হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"

#: classes/DomainMOD/SslRefresh.php:368
msgid "The SSL certificate couldn't be updated. Please try again."
msgstr "SSL সার্টিফিকেট আপডেট করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"

#. TRANSLATORS: %1$s is the SSL certificate's status before the refresh, and %2$s is its new status.
#: classes/DomainMOD/SslRefresh.php:411
msgid "Status changed from %1$s to %2$s."
msgstr "স্ট্যাটাস %1$s থেকে %2$s এ পরিবর্তিত হয়েছে।"

#: classes/DomainMOD/SslRefresh.php:424
msgid "The certificate no longer names its issuer."
msgstr "সার্টিফিকেট আর ইস্যুকারীকে নাম উল্লেখ করে না।"

#. TRANSLATORS: %s is the name of the company that issued the SSL certificate, such as Let's Encrypt.
#: classes/DomainMOD/SslRefresh.php:433
msgid "The certificate is now issued by %s."
msgstr "সার্টিফিকেটটি এখন %s দ্বারা ইস্যু করা হয়।"

#: classes/DomainMOD/SslRefresh.php:467
msgid "This certificate has expired."
msgstr "এই সার্টিফিকেটটির মেয়াদ শেষ হয়ে গেছে।"

#: classes/DomainMOD/SslRefresh.php:470
msgid "This certificate is self-signed."
msgstr "এই সার্টিফিকেটটি স্ব-স্বাক্ষরিত।"

#: classes/DomainMOD/SslRefresh.php:470
msgid "This certificate isn't trusted."
msgstr "এই সার্টিফিকেটটি বিশ্বাসযোগ্য নয়।"

