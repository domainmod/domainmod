#: restore.php:50
msgid "Usage: php restore.php <backup file> --temp-dir=<folder>, php restore.php --recover, or php restore.php --forget-staged"
msgstr "Gebruik: php restore.php <back-upbestand> --temp-dir=<map>, php restore.php --recover of php restore.php --forget-staged"

