msgid "Can't read %s. Run this as the web server's user."
msgstr "%s kan niet worden gelezen. Voer dit uit als de gebruiker van de webserver."

#: restore.php:85
msgid "Can't write to DomainMOD's temp folder. Make it writable by the web server's user, then try again."
msgstr "Er kan niet worden geschreven naar de tijdelijke map van DomainMOD. Maak deze map schrijfbaar voor de gebruiker van de webserver en probeer het vervolgens opnieuw."

#: restore.php:87
msgid "Can't open temp/restore.lock for writing. Run this as the web server's user."
msgstr "Het bestand temp/restore.lock kan niet worden geopend om te schrijven. Voer dit uit als de gebruiker van de webserver."

#: restore.php:100
msgid "There is no staged backup copy to forget."
msgstr "Er is geen tussentijdse back-upkopie om te vergeten."

#: restore.php:103
msgid "This forgets the staged backup copy at %s without deleting it. Only do this if the file is already gone. Type yes to go on:"
msgstr "Hierbij wordt de tijdelijke back-up in %s genegeerd zonder deze te verwijderen. Doe dit alleen als het bestand al verdwenen is. Typ ‘yes’ om door te gaan:"

#: restore.php:145
msgid "The staged backup copy changed while you were answering, so nothing was changed."
msgstr "De tussentijdse back-upkopie is gewijzigd terwijl u aan het antwoorden was, dus er is niets gewijzigd."

#: restore.php:149
msgid "The staged backup copy was forgotten."
msgstr "De tussentijdse back-upkopie is vergeten."

#: restore.php:149
msgid "The staged backup copy's record couldn't be removed."
msgstr "Het record van de gefaseerde back-up kon niet worden verwijderd."

#: restore.php:164
msgid "The restore was finished."
msgstr "Het herstel is voltooid."

#: restore.php:171
msgid "The staged backup copy was removed."
msgstr "De tijdelijke back-up is verwijderd."

#: restore.php:171
msgid "Nothing was left to finish."
msgstr "Er hoefde niets meer afgemaakt te worden."

#: restore.php:181
msgid "The --temp-dir folder doesn't exist or can't be written to."
msgstr "De map --temp-dir bestaat niet of er kan niet naar worden geschreven."

#: restore.php:187
msgid "The --temp-dir folder can't be inside DomainMOD's folder. Use a private folder outside the web root."
msgstr "De map --temp-dir mag niet in de map van DomainMOD staan. Gebruik een aparte map buiten de webroot."

#: restore.php:211
msgid "The restore finished."
msgstr "Het herstel is voltooid."

