#: classes/DomainMOD/UpgradeGuide.php:71
msgid "A %s folder was found in the installation folder."
msgstr "Er is een map met de naam %s aangetroffen in de installatiemap."

#. TRANSLATORS: %s is a file name (.git). Don't translate it.
#: classes/DomainMOD/UpgradeGuide.php:74
msgid "A %s file was found in the installation folder, so it's a Git worktree or submodule."
msgstr "Er is een %s-bestand aangetroffen in de installatiemap, dus het gaat om een Git-werkboom of een submodule."

#: classes/DomainMOD/UpgradeGuide.php:76
msgid "The files came from a release archive, such as the zip file."
msgstr "De bestanden waren afkomstig uit een archief, zoals het zip-bestand."

#: classes/DomainMOD/UpgradeGuide.php:78
msgid "No sign of a Docker, Git, or zip file installation was found."
msgstr "Er zijn geen aanwijzingen gevonden voor een installatie via Docker, Git of een zip-bestand."

#: classes/DomainMOD/UpgradeGuide.php:99
msgid "Download the new zip file from %s."
msgstr "Download het nieuwe zip-bestand van %s."

